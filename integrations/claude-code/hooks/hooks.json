{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mdh >/dev/null 2>&1 && mdh hook session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v mdh >/dev/null 2>&1 && mdh hook stop || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
